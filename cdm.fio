[global]
direct=1
size=1G
loops=5
group_reporting=1
filename=fio_disk_test.tmp

[SEQ1M-Q8T1-Read]
rw=read
bs=1m
iodepth=8
numjobs=1

[SEQ1M-Q8T1-Write]
rw=write
bs=1m
iodepth=8
numjobs=1

[SEQ128K-Q32T1-Read]
rw=read
bs=128k
iodepth=32
numjobs=1

[SEQ128K-Q32T1-Write]
rw=write
bs=128k
iodepth=32
numjobs=1

[RND4K-Q32T16-Read]
rw=randread
bs=4k
iodepth=32
numjobs=16

[RND4K-Q32T16-Write]
rw=randwrite
bs=4k
iodepth=32
numjobs=16

[RND4K-Q1T1-Read]
rw=randread
bs=4k
iodepth=1
numjobs=1

[RND4K-Q1T1-Write]
rw=randwrite
bs=4k
iodepth=1
numjobs=1
